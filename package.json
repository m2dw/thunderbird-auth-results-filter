{
  "name": "thunderbird-auth-results-filter",
  "version": "0.8.2",
  "type": "module",
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "postinstall": "node scripts/vendor.mjs",
    "package": "node scripts/vendor.mjs && node scripts/generate-icons.mjs && node scripts/package-xpi.mjs"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "jest": "^29.7.0"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "transform": {},
        "testPathIgnorePatterns": [
          "/node_modules/",
          "<rootDir>/test/xpiPackaging.test.js"
        ]
      },
      {
        "displayName": "packaging",
        "testEnvironment": "node",
        "transform": {},
        "testMatch": [
          "<rootDir>/test/xpiPackaging.test.js"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/"
        ]
      }
    ]
  },
  "dependencies": {
    "jsep": "1.4.0",
    "mail-auth-signal": "0.5.2",
    "tldts": "7.4.0"
  }
}
