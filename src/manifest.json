{
  "manifest_version": 2,
  "name": "__MSG_page_title__",
  "description": "__MSG_manifest_description__",
  "default_locale": "en",
  "version": "0.8.1",
  "author": "Motoaki Kusakabe",
  "browser_specific_settings": {
    "gecko": {
      "id": "auth-results-filter@thunderbird",
      "strict_min_version": "102.0"
    }
  },
  "permissions": [
    "accountsRead",
    "accountsFolders",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "notifications",
    "storage",
    "*://dns.google/*",
    "*://cloudflare-dns.com/*",
    "*://1.1.1.1/*",
    "*://1.0.0.1/*"
  ],
  "optional_permissions": [
    "addressBooks"
  ],
  "background": {
    "page": "background/background.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "message_display_action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "message-display/popup.html",
    "default_title": "Auth Results Filter"
  }
}
